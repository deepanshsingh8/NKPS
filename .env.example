NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Resend — every transactional email (account set-password links, password
# reset, registration updates, contact form). Supabase's own mailer is not
# used. Get a key at https://resend.com. The FROM address MUST be on a domain
# you've verified in Resend; FROM_EMAIL defaults to noreply@nkpublicschool.com.
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=NK Public School <noreply@nkpublicschool.com>
# Replies to transactional emails route here (any mailbox, no verification needed).
REPLY_TO_EMAIL=nkps.rajawas@gmail.com

# SEO — public site URL used for canonical, sitemap, and JSON-LD @id nodes.
NEXT_PUBLIC_SITE_URL=https://www.nkpublicschool.com

# Cross-app URLs — each app is deployed separately, so links between them must
# be absolute. In dev, point at the local ports. In Vercel production, set
# these to the deployed subdomains for each Vercel project.
# Dev defaults: 3001 / 3002 / 3003.
NEXT_PUBLIC_WEBSITE_URL=https://www.nkpublicschool.com
NEXT_PUBLIC_CMS_URL=https://cms.nkpublicschool.com
NEXT_PUBLIC_ERP_URL=https://erp.nkpublicschool.com

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Leave blank in dev.
NEXT_PUBLIC_GA_ID=

# Google Search Console meta-tag verification token (the content value only).
# Only needed if verifying via HTML tag; DNS / file verification doesn't need this.
NEXT_PUBLIC_GSC_VERIFICATION=

# Google Maps JS API key — enables transport address autocomplete + road-distance.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Exotel — click-to-call with number masking (ERP students page). All server-only
# (never NEXT_PUBLIC_). Leave blank to disable calling; the UI stays but returns
# a "not configured" message. Find SID/key/token in the Exotel dashboard.
#   EXOTEL_CALLER_ID is your provisioned ExoPhone (the masked number parents see).
#   EXOTEL_SUBDOMAIN defaults to api.exotel.com; Indian accounts may use api.in.exotel.com.
#   EXOTEL_CALLBACK_TOKEN is any long random string — it gates the public
#     status-callback webhook (Exotel can't send our auth header). The webhook is
#     reachable at ${NEXT_PUBLIC_ERP_URL}/api/telephony/exotel-callback.
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLBACK_TOKEN=

# Rate limiting — the single request header that carries the real client IP,
# set (and overwritten) by the proxy in front of the app. Without it the limiter
# falls back to x-forwarded-for, which a client can spoof to get a fresh bucket
# per request. On Vercel: x-vercel-forwarded-for (or x-real-ip). Behind
# Cloudflare: cf-connecting-ip. Leave blank in dev.
TRUSTED_IP_HEADER=
